# ===== PostgreSQL =====
POSTGRES_DB=petfriendlydb
POSTGRES_USER=petfriendly
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ===== MinIO (S3 compatible) =====
MINIO_ROOT_USER=petfriendly
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
S3_BUCKET=petfriendly-images

# ===== JWT =====
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_256_bits_base64_string
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_DAYS=7

# ===== CORS (origines du front admin, séparées par des virgules) =====
# En prod NE PAS laisser "*". Ex: https://admin.petfriendly.fr
CORS_ALLOWED_ORIGINS=https://admin.example.com

# ===== Caddy =====
# Sans domaine (HTTP sur IP) : SITE_ADDRESS=:80  + laisser ACME_EMAIL vide
# Avec domaine (HTTPS auto Let's Encrypt) : SITE_ADDRESS=api.tondomaine.fr + ACME_EMAIL rempli
SITE_ADDRESS=:80
ACME_EMAIL=

# ===== Sentry (optionnel) =====
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
APP_VERSION=1.0.0