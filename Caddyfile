# Adresse du site = valeur de $SITE_ADDRESS.
#   - HTTPS auto (Let's Encrypt) : SITE_ADDRESS=api.tondomaine.fr
#   - HTTP seul sur IP (pas de domaine) : SITE_ADDRESS=:80
{$SITE_ADDRESS::80} {
    encode zstd gzip

    @api path /api/* /actuator/health /swagger-ui* /api-docs*
    handle @api {
        reverse_proxy app:8080
    }

    handle {
        respond "PetFriendly API" 200
    }

    log {
        output stdout
        format console
    }
}
